# Jashn Environment Variables Configuration

# Google Gemini API Key (Optional - application runs full deterministic planner offline without it)
GEMINI_API_KEY=""

# Gemini Model Selection (Defaults to gemini-2.5-flash with fallback to gemini-1.5-flash)
NEXT_PUBLIC_GEMINI_MODEL="gemini-2.5-flash"

# App URL for absolute canonical URLs and metadata
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Rate Limiting Configuration
RATE_LIMIT_MAX_REQUESTS_PER_MINUTE="30"
