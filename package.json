{
  "name": "@outage-iq/root",
  "version": "1.0.0",
  "description": "OutageIQ - Real-time automated incident detection and intelligence platform",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api",
    "apps/worker",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace=apps/web run dev",
    "dev:api": "npm --workspace=apps/api run dev",
    "dev:worker": "npm --workspace=apps/worker run dev",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:worker\" \"npm run dev:web\"",
    "build:shared": "npm --workspace=@outage-iq/shared run build",
    "build:api": "npm --workspace=apps/api run build",
    "build:worker": "npm --workspace=apps/worker run build",
    "build:web": "npm --workspace=apps/web run build",
    "db:migrate": "npm --workspace=apps/worker run db:migrate"
  },
  "license": "MIT"
}